# Copy to .env and replace every placeholder. Never commit .env.
DB_PASSWORD=change-me
# 32+ random characters. Generate one:  openssl rand -base64 48   (PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 })) )
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Optional AI (Groq). Leave GROQ_API_KEY empty and the whole app runs on its rule-based engine.
# Get a key at https://console.groq.com . The key stays on the backend; the browser never sees it.
GROQ_API_KEY=
# Check https://console.groq.com/docs/models: Groq retires models over time (llama-3.3-70b-versatile was retired in Aug 2026).
GROQ_MODEL=openai/gpt-oss-120b
